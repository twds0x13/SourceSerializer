# ── 通用 ──────────────────────────────────────────────────
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
insert_final_newline = true
trim_trailing_whitespace = false

[*.md]
indent_size = unset

# ── C# 命名规则 ──────────────────────────────────────────

# 私有实例字段: _camelCase
dotnet_naming_rule.private_instance_field_underscore.severity = suggestion
dotnet_naming_rule.private_instance_field_underscore.symbols  = private_instance_fields
dotnet_naming_rule.private_instance_field_underscore.style    = underscore_camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds   = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers = instance

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# 静态/const 字段: PascalCase（无下划线）
dotnet_naming_rule.static_const_fields.severity = suggestion
dotnet_naming_rule.static_const_fields.symbols  = static_const_fields
dotnet_naming_rule.static_const_fields.style    = pascal_case

dotnet_naming_symbols.static_const_fields.applicable_kinds   = field
dotnet_naming_symbols.static_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_const_fields.required_modifiers = static

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.pascal_case.required_prefix =

# 其余：PascalCase（类型、方法、属性、public/internal 字段）
dotnet_naming_rule.types_and_members.severity = suggestion
dotnet_naming_rule.types_and_members.symbols  = types_and_members
dotnet_naming_rule.types_and_members.style    = pascal_case

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, property, method, event, delegate

# 局部变量和参数: camelCase
dotnet_naming_rule.locals_and_params.severity = suggestion
dotnet_naming_rule.locals_and_params.symbols  = locals_and_params
dotnet_naming_rule.locals_and_params.style    = camel_case

dotnet_naming_symbols.locals_and_params.applicable_kinds = parameter, local

dotnet_naming_style.camel_case.capitalization = camel_case

# ── C# 风格 ──────────────────────────────────────────────

[*.cs]
# var: 类型明显时使用
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 内置类型优先（int > Int32）
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# this / IEnumerable 限定
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# 表达式体
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion

# using 放在命名空间内
csharp_using_directive_placement = inside_namespace:suggestion

# 空值检查
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# 模式匹配
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
