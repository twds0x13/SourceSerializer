<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- Runtime source files from the UPM package -->
  <ItemGroup>
    <Compile Include="../../packages/sourceserializer/Runtime/Attributes/TemplateAttribute.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/Attributes/TagAttribute.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/Attributes/TypeAliasAttribute.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/Attributes/ExternalTemplateAttribute.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/Attributes/TemplateIgnoreAttribute.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/ISerializerBlock.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/ChainBlock.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/BuiltinBlocks.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/SerializerRegistry.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/SerializerBlocks.cs" />
    <Compile Include="../../packages/sourceserializer/Runtime/WhitespaceStripper.cs" />
  </ItemGroup>

  <!-- Benchmark source file -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- Source Generator as Analyzer (compile-time code gen for [Template] types) -->
  <ItemGroup>
    <ProjectReference Include="../../packages/sourceserializer/SourceGenerator~/SourceSerializer.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
